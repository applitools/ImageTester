									<exclude>com.applitools:eyes-universal-core-mac</exclude>
									<exclude>com.applitools:eyes-universal-core-mac-arm</exclude>
									<exclude>com.applitools:eyes-universal-core-alpine</exclude>
									<exclude>com.applitools:eyes-universal-core-arm</exclude>
								</excludes>
							</artifactSet>
						</configuration>
					</execution>
					<execution>
						<id>shade-alpine</id>
						<phase>package</phase>
						<goals>
							<goal>shade</goal>
						</goals>
						<configuration>
							<outputFile>${project.basedir}/jars/${project.artifactId}_${project.version}_Alpine.jar</outputFile>
							<shadedArtifactAttached>true</shadedArtifactAttached>
							<shadedClassifierName>alpine</shadedClassifierName>
							<artifactSet>
								<excludes>
									<exclude>com.applitools:eyes-universal-core-win</exclude>
									<exclude>com.applitools:eyes-universal-core-mac</exclude>
									<exclude>com.applitools:eyes-universal-core-mac-arm</exclude>
									<exclude>com.applitools:eyes-universal-core-linux</exclude>
									<exclude>com.applitools:eyes-universal-core-arm</exclude>
								</excludes>
							</artifactSet>
						</configuration>
					</execution>
					<execution>
						<id>shade-arm</id>
						<phase>package</phase>
						<goals>
							<goal>shade</goal>
						</goals>
						<configuration>
							<outputFile>${project.basedir}/jars/${project.artifactId}_${project.version}_Arm.jar</outputFile>
							<shadedArtifactAttached>true</shadedArtifactAttached>
							<shadedClassifierName>arm</shadedClassifierName>
							<artifactSet>
								<excludes>
									<exclude>com.applitools:eyes-universal-core-win</exclude>
									<exclude>com.applitools:eyes-universal-core-mac</exclude>
									<exclude>com.applitools:eyes-universal-core-mac-arm</exclude>
									<exclude>com.applitools:eyes-universal-core-linux</exclude>
									<exclude>com.applitools:eyes-universal-core-alpine</exclude>
								</excludes>
							</artifactSet>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<!-- This plugin required to control version addition to the manifest so it will be consumable on runtime -->
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-jar-plugin</artifactId>
				<version>3.2.2</version>
				<configuration>
					<archive>
						<manifest>
							<addDefaultImplementationEntries>true</addDefaultImplementationEntries>
							<addDefaultSpecificationEntries>true</addDefaultSpecificationEntries>
						</manifest>
					</archive>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<version>3.10.1</version>
				<configuration>
					<source>11</source>
					<target>11</target>
				</configuration>
			</plugin>

			<plugin>
				<groupId>com.github.eirslett</groupId>
				<artifactId>frontend-maven-plugin</artifactId>
				<version>1.15.0</version>
				<configuration>
					<workingDirectory>frontend</workingDirectory>
					<installDirectory>${project.build.directory}</installDirectory>
					<nodeVersion>v20.12.2</nodeVersion>
				</configuration>
				<executions>
					<execution>
						<id>install-node-and-npm</id>
						<goals><goal>install-node-and-npm</goal></goals>
						<phase>generate-resources</phase>
					</execution>
					<execution>
						<id>npm-ci</id>
						<goals><goal>npm</goal></goals>
						<phase>generate-resources</phase>
						<configuration><arguments>ci</arguments></configuration>
					</execution>
					<execution>
						<id>npm-run-build</id>
						<goals><goal>npm</goal></goals>
						<phase>generate-resources</phase>
						<configuration><arguments>run build</arguments></configuration>
					</execution>
				</executions>
			</plugin>

			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-resources-plugin</artifactId>
				<version>3.3.1</version>
				<executions>
					<execution>
						<id>copy-frontend-bundle</id>
						<phase>process-resources</phase>
						<goals><goal>copy-resources</goal></goals>
						<configuration>
							<!-- overwrite: never let a newer-destination timestamp skip the copy -->
							<overwrite>true</overwrite>
							<outputDirectory>${project.build.outputDirectory}/web</outputDirectory>
							<resources>
								<resource>
									<directory>${project.basedir}/frontend/dist</directory>
								</resource>
							</resources>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>

	<profiles>
		<profile>
			<id>eyes-tests</id>
			<build>
				<plugins>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-surefire-plugin</artifactId>
						<configuration>
							<excludes combine.self="override" />
							<includes>
								<include>Tests/**</include>
							</includes>
							<parallel>methods</parallel>
							<threadCount>4</threadCount>
						</configuration>
					</plugin>
				</plugins>
			</build>
		</profile>
		<profile>
			<id>multi-format-tests</id>
			<build>
				<plugins>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-surefire-plugin</artifactId>
						<configuration>
							<excludes combine.self="override" />
							<includes>
								<include>Tests/MultiFormatIntegrationTest.java</include>
							</includes>
						</configuration>
					</plugin>
				</plugins>
			</build>
		</profile>
		<profile>
			<!--
				gui-installers profile: builds per-OS installers via jpackage.
				Requires JDK 14+ on PATH (jpackage was introduced in JDK 14).
				Local JDK 11 cannot run this profile; intended for CI on JDK 17.
				Run with: mvn -Pgui-installers -DskipTests -Dowasp.skip=true clean verify
				Output: target/installers/ImageTester-*.{msi|dmg|deb}

				The os-* sub-profiles (below) auto-activate based on the host and pick the
				slim per-OS shaded JAR (e.g. ImageTester_3.10.0_Windows.jar, ~62MB) instead
				of the fat universal one (~233MB).
			-->
			<id>gui-installers</id>
			<build>
				<plugins>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-resources-plugin</artifactId>
						<executions>
							<execution>
								<id>stage-installer-input</id>
								<phase>pre-integration-test</phase>
								<goals><goal>copy-resources</goal></goals>
								<configuration>
									<outputDirectory>${project.build.directory}/installer-input</outputDirectory>
									<resources>
										<resource>
											<directory>${project.basedir}/jars</directory>
											<includes>
												<include>${installer.input.jar}</include>
											</includes>
										</resource>
									</resources>
								</configuration>
							</execution>
						</executions>
					</plugin>
					<plugin>
						<groupId>org.codehaus.mojo</groupId>
						<artifactId>exec-maven-plugin</artifactId>
						<version>3.1.1</version>
						<executions>
							<execution>
								<id>run-jpackage</id>
								<phase>verify</phase>
								<goals><goal>exec</goal></goals>
								<configuration>
									<executable>jpackage</executable>
									<arguments>
										<argument>--input</argument>
										<argument>${project.build.directory}/installer-input</argument>
										<argument>--type</argument>
										<argument>${installer.type}</argument>
										<argument>--name</argument>
										<argument>ImageTester</argument>
										<argument>--main-jar</argument>
										<argument>${installer.input.jar}</argument>
										<argument>--main-class</argument>
										<argument>com.applitools.imagetester.ImageTester</argument>
										<argument>--arguments</argument>
										<argument>--gui</argument>
										<argument>--app-version</argument>
										<argument>${project.version}</argument>
										<argument>--description</argument>
										<argument>Visual testing tool — uploads screenshots and PDF pages to Applitools Eyes</argument>
										<argument>--copyright</argument>
										<argument>Copyright © Applitools</argument>
										<argument>--vendor</argument>
										<argument>Applitools</argument>
										<argument>--dest</argument>
										<argument>${project.build.directory}/installers</argument>
									</arguments>
								</configuration>
							</execution>
						</executions>
					</plugin>
				</plugins>
			</build>
		</profile>

		<!--
			OS-detection sub-profiles for gui-installers: each auto-activates on its host and
			sets ${installer.input.jar} to the correct slim shade plus ${installer.type} and any
			OS-specific jpackage flags. Only consumed when -Pgui-installers is also active;
			harmless properties otherwise.
		-->
		<profile>
			<id>installer-os-windows</id>
			<activation><os><family>windows</family></os></activation>
			<properties>
				<installer.input.jar>ImageTester_${project.version}_Windows.jar</installer.input.jar>
				<!--
					msi, not exe: jpackage's exe wrapper ships without a supportedOS manifest,
					so Windows PCA shows "This program might not have installed correctly"
					even though the install succeeded. msiexec is exempt from that heuristic.
				-->
				<installer.type>msi</installer.type>
			</properties>
			<build>
				<plugins>
					<plugin>
						<groupId>org.codehaus.mojo</groupId>
						<artifactId>exec-maven-plugin</artifactId>
						<version>3.1.1</version>
						<executions>
							<execution>
								<id>run-jpackage</id>
								<configuration>
									<arguments combine.children="append">
										<argument>--win-menu</argument>
										<argument>--win-shortcut</argument>
									</arguments>
								</configuration>
							</execution>
						</executions>
					</plugin>
				</plugins>
			</build>
		</profile>
		<profile>
			<id>installer-os-mac-arm</id>
			<activation><os><family>mac</family><arch>aarch64</arch></os></activation>
			<properties>
				<installer.input.jar>ImageTester_${project.version}_MacArm.jar</installer.input.jar>
				<installer.type>dmg</installer.type>
			</properties>
		</profile>
		<profile>
			<id>installer-os-mac-x64</id>
			<activation><os><family>mac</family><arch>x86_64</arch></os></activation>
			<properties>
				<installer.input.jar>ImageTester_${project.version}_Mac.jar</installer.input.jar>
				<installer.type>dmg</installer.type>
			</properties>
		</profile>
		<profile>
			<id>installer-os-linux</id>
			<activation><os><family>unix</family><name>linux</name></os></activation>
			<properties>
				<installer.input.jar>ImageTester_${project.version}_Linux.jar</installer.input.jar>
				<installer.type>deb</installer.type>
			</properties>
		</profile>
	</profiles>
</project>
