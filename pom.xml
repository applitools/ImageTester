						<id>shade-linux</id>
						<phase>package</phase>
						<goals>
							<goal>shade</goal>
						</goals>
						<configuration>
							<outputFile>${project.basedir}/jars/${project.artifactId}_${project.version}_Linux.jar</outputFile>
							<shadedArtifactAttached>true</shadedArtifactAttached>
							<shadedClassifierName>linux</shadedClassifierName>
							<artifactSet>
